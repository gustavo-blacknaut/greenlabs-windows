#include <windows.h>

// A logo entra dentro do proprio .exe: nada de arquivo solto ao lado que a
// pessoa possa apagar sem querer, e o aplicativo continua sendo um arquivo so.

1 ICON    "../assets/logo.ico"

// RCDATA em vez de tipo BITMAP: o PNG vai cru e quem decodifica e o WIC, que
// entende transparencia. O tipo BITMAP do Windows nao entende PNG.
100 RCDATA "../assets/logo.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,0,1,0
PRODUCTVERSION 0,0,1,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GreenCodes"
            VALUE "FileDescription",  "GreenLabs Live Streaming"
            VALUE "FileVersion",      "0.2.7"
            VALUE "InternalName",     "GreenLabs"
            VALUE "OriginalFilename", "GreenLabs.exe"
            VALUE "ProductName",      "GreenLabs"
            VALUE "ProductVersion",   "0.2.7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
