#include <windows.h>

// Gerado pelo CMake a partir deste modelo: a versao aqui ficava para tras
// a cada release, e o .exe anunciava 0.3.2 muito depois da 1.1.4 ter saido.

// A logo entra dentro do proprio .exe: nada de arquivo solto ao lado que a
// pessoa possa apagar sem querer, e o aplicativo continua sendo um arquivo so.

1 ICON    "@CMAKE_CURRENT_SOURCE_DIR@/assets/logo.ico"

// RCDATA em vez de tipo BITMAP: o PNG vai cru e quem decodifica e o WIC, que
// entende transparencia. O tipo BITMAP do Windows nao entende PNG.
100 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/logo.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @GREENLABS_VERSAO_RC@
PRODUCTVERSION @GREENLABS_VERSAO_RC@
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GreenCodes"
            VALUE "FileDescription",  "GreenLabs Live Streaming"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "GreenLabs"
            VALUE "OriginalFilename", "GreenLabs.exe"
            VALUE "ProductName",      "GreenLabs"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
